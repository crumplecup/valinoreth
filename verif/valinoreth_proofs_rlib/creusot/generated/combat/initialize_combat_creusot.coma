predicate inv_CombatState (_1: t_CombatState)

axiom inv_axiom'2 [@rewrite]: forall x: t_CombatState [inv_CombatState x]. inv_CombatState x
    = match x with
      | Uninitialized -> true
      | Active combatants turn_order current_actor round -> inv_Vec_CombatantState_Global combatants
      | Concluded victor -> inv_Option_String victor
      end

predicate inv_Established_CombatConsistent (_1: t_Established_CombatConsistent)

predicate inv_Established_CombatInitialized (_1: t_Established_CombatInitialized)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec: forall self: t_Vec_usize_Global. [%#svec] Seq.length (view_Vec_usize_Global self)
