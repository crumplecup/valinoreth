meta "rewrite_def" predicate invariant_ref_CombatantState

predicate inv_ref_CombatantState [@inline:trivial] (_1: t_CombatantState) = invariant_ref_CombatantState _1

meta "rewrite_def" predicate inv_ref_CombatantState

predicate invariant_Seq_CombatantState [@inline:trivial] (self: Seq.seq t_CombatantState) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_CombatantState (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_CombatantState

predicate inv_Seq_CombatantState [@inline:trivial] (_1: Seq.seq t_CombatantState) = invariant_Seq_CombatantState _1

meta "rewrite_def" predicate inv_Seq_CombatantState

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_CombatantState_Global (self: t_Vec_CombatantState_Global) : Seq.seq t_CombatantState

axiom view_Vec_CombatantState_Global_spec:
  forall self: t_Vec_CombatantState_Global. [%#svec] Seq.length (view_Vec_CombatantState_Global self)
    <= UInt64.t'int const_MAX

predicate invariant_Vec_CombatantState_Global (self: t_Vec_CombatantState_Global) =
