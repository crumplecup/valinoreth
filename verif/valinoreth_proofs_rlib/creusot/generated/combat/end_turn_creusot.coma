predicate inv_Vec_CombatantState_Global (_1: t_Vec_CombatantState_Global)

axiom inv_axiom'0:
  forall x: t_Vec_CombatantState_Global [inv_Vec_CombatantState_Global x]. inv_Vec_CombatantState_Global x
    -> invariant_Vec_CombatantState_Global x

predicate inv_Option_String (_1: t_Option_String)

axiom inv_axiom'1 [@rewrite]: forall x: t_Option_String [inv_Option_String x]. inv_Option_String x
    = match x with
      | None -> true
      | Some f0'0 -> inv_String f0'0
      end

predicate inv_CombatState (_1: t_CombatState)

axiom inv_axiom'2 [@rewrite]: forall x: t_CombatState [inv_CombatState x]. inv_CombatState x
    = match x with
      | Uninitialized -> true
      | Active combatants turn_order current_actor round -> inv_Vec_CombatantState_Global combatants
      | Concluded victor -> inv_Option_String victor
      end

predicate inv_Established_CombatConsistent (_1: t_Established_CombatConsistent)

predicate inv_Established_TurnEnded (_1: t_Established_TurnEnded)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec: forall self: t_Vec_usize_Global. [%#svec] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

predicate combat_consistent_creusot [#"/home/erik/repos/valinoreth/valinoreth_proofs/src/creusot/generated/combat.rs" 24 0 24 67] (state: t_CombatState) =
  [%#scombat'12] match state with
    | Uninitialized -> true
    | Concluded _ -> true
    | Active combatants turn_order current_actor round -> Seq.length (view_Vec_CombatantState_Global combatants) > 0
    /\ Seq.length (view_Vec_usize_Global turn_order) > 0
    /\ UInt64.t'int current_actor < Seq.length (view_Vec_usize_Global turn_order)
    /\ UInt32.t'int round > 0
    /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global turn_order)
      -> UInt64.t'int (Seq.get (view_Vec_usize_Global turn_order) i)
      < Seq.length (view_Vec_CombatantState_Global combatants))
    end

predicate inv_tup2_CombatState_Established_CombatConsistent [@inline:trivial] (_1: tup2_CombatState_Established_CombatConsistent) =
  inv_CombatState _1.f0 /\ inv_Established_CombatConsistent _1.f1

meta "rewrite_def" predicate inv_tup2_CombatState_Established_CombatConsistent

let rec end_turn (state: t_CombatState) (proof: t_Established_CombatConsistent) (_turn_proof: t_Established_TurnEnded)
  (return (x: tup2_CombatState_Established_CombatConsistent)) =
  {[@stop_split] [@expl:end_turn requires] ([@stop_split] [@expl:end_turn 'state' type invariant] [%#scombat'6] inv_CombatState state)
  /\ ([@stop_split] [@expl:end_turn 'proof' type invariant] [%#scombat'7] inv_Established_CombatConsistent proof)
  /\ ([@stop_split] [@expl:end_turn '_turn_proof' type invariant] [%#scombat'8] inv_Established_TurnEnded _turn_proof)
  /\ ([@stop_split] [@expl:end_turn requires] [%#scombat'9] combat_consistent_creusot state)}
  any
  [ return (result: tup2_CombatState_Established_CombatConsistent) ->
  {[@stop_split] [@expl:end_turn ensures] ([@stop_split] [@expl:end_turn result type invariant] [%#scombat'10] inv_tup2_CombatState_Established_CombatConsistent result)
    /\ ([@stop_split] [@expl:end_turn ensures] [%#scombat'11] combat_consistent_creusot result.f0)}
    (! return {result}) ]

