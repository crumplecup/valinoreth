type t_Vec_CombatantState_Global

type t_Vec_usize_Global

type t_String

type t_Option_String = None | Some t_String

type t_CombatState =
  | Uninitialized
  | Active t_Vec_CombatantState_Global t_Vec_usize_Global UInt64.t UInt32.t
  | Concluded t_Option_String

