predicate inv_String (_1: t_String)

predicate inv_CombatantState (_1: t_CombatantState)

axiom inv_axiom [@rewrite]: forall x: t_CombatantState [inv_CombatantState x]. inv_CombatantState x
    = (inv_String x.id /\ inv_String x.team)

predicate invariant_ref_CombatantState [@inline:trivial] (self: t_CombatantState) =
