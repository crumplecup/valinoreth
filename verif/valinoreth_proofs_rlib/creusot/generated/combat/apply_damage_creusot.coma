  /\ ([@stop_split] [@expl:apply_damage 'declared_target' type invariant] [%#scombat'10] inv_DeclaredAttackTarget declared_target)
  /\ ([@stop_split] [@expl:apply_damage '_damage_proof' type invariant] [%#scombat'11] inv_Established_DamageApplied _damage_proof)
  /\ ([@stop_split] [@expl:apply_damage requires #0] [%#scombat'12] combat_consistent_creusot state)
  /\ ([@stop_split] [@expl:apply_damage requires #1] [%#scombat'13] Int32.to_int injury >= 0)}
  any
  [ return (result: tup2_CombatState_Established_CombatConsistent) ->
  {[@stop_split] [@expl:apply_damage ensures] ([@stop_split] [@expl:apply_damage result type invariant] [%#scombat'14] inv_tup2_CombatState_Established_CombatConsistent result)
    /\ ([@stop_split] [@expl:apply_damage ensures] [%#scombat'15] combat_consistent_creusot result.f0)}
    (! return {result}) ]

