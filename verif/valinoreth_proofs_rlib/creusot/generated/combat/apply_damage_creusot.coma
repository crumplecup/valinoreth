    | Concluded _ -> true
    | Active combatants turn_order current_actor round -> Seq.length (view_Vec_CombatantState_Global combatants) > 0
    /\ Seq.length (view_Vec_usize_Global turn_order) > 0
    /\ UInt64.t'int current_actor < Seq.length (view_Vec_usize_Global turn_order)
    /\ UInt32.t'int round > 0
    /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global turn_order)
      -> UInt64.t'int (Seq.get (view_Vec_usize_Global turn_order) i)
      < Seq.length (view_Vec_CombatantState_Global combatants))
    end

