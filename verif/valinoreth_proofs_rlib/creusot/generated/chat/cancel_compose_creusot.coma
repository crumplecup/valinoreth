  [ bb0 = s0
    [ s0 = cancel_compose [%#schat] {state} {proof}
        (fun (_x: tup2_ChatState_Established_ChatConsistent) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: tup2_ChatState_Established_ChatConsistent = Any.any_l ()
  | & state: t_ChatState = state
  | & proof: t_Established_ChatConsistent = proof ])
  [ return (result: tup2_ChatState_Established_ChatConsistent) ->
  {[@stop_split] [@expl:cancel_compose_creusot ensures] ([@stop_split] [@expl:cancel_compose_creusot result type invariant] [%#schat'3] inv_tup2_ChatState_Established_ChatConsistent result)
