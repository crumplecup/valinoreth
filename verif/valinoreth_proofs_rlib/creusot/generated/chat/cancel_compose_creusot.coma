  [#"/home/erik/repos/valinoreth/valinoreth_proofs/src/creusot/generated/chat.rs" 80 0 83 45] (state: t_ChatState)
  (proof: t_Established_ChatConsistent) (return (x: tup2_ChatState_Established_ChatConsistent)) =
