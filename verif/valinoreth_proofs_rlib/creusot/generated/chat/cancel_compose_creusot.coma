  /\ ([@stop_split] [@expl:cancel_compose_creusot 'proof' type invariant] [%#schat'1] inv_Established_ChatConsistent proof)
  /\ ([@stop_split] [@expl:cancel_compose_creusot requires] [%#schat'2] chat_consistent_creusot state)}
