use creusot.prelude.Any

type t_String

type t_ChatState = Viewing | Composing t_String

type t_Established_ChatConsistent

type tup2_ChatState_Established_ChatConsistent = { f0: t_ChatState; f1: t_Established_ChatConsistent }

predicate inv_String (_1: t_String)

predicate inv_ChatState (_1: t_ChatState)

axiom inv_axiom [@rewrite]: forall x: t_ChatState [inv_ChatState x]. inv_ChatState x
    = match x with
      | Viewing -> true
      | Composing buffer -> inv_String buffer
      end

predicate inv_Established_ChatConsistent (_1: t_Established_ChatConsistent)

predicate chat_consistent_creusot [#"/home/erik/repos/valinoreth/valinoreth_proofs/src/creusot/generated/chat.rs" 22 0 22 64] (_state: t_ChatState) =
  [%#schat'10] true

predicate inv_tup2_ChatState_Established_ChatConsistent [@inline:trivial] (_1: tup2_ChatState_Established_ChatConsistent) =
  inv_ChatState _1.f0 /\ inv_Established_ChatConsistent _1.f1

meta "rewrite_def" predicate inv_tup2_ChatState_Established_ChatConsistent

let rec send_message (state: t_ChatState) (proof: t_Established_ChatConsistent)
  (return (x: tup2_ChatState_Established_ChatConsistent)) =
  {[@stop_split] [@expl:send_message requires] ([@stop_split] [@expl:send_message 'state' type invariant] [%#schat'5] inv_ChatState state)
  /\ ([@stop_split] [@expl:send_message 'proof' type invariant] [%#schat'6] inv_Established_ChatConsistent proof)
  /\ ([@stop_split] [@expl:send_message requires] [%#schat'7] chat_consistent_creusot state)}
  any
  [ return (result: tup2_ChatState_Established_ChatConsistent) ->
  {[@stop_split] [@expl:send_message ensures] ([@stop_split] [@expl:send_message result type invariant] [%#schat'8] inv_tup2_ChatState_Established_ChatConsistent result)
    /\ ([@stop_split] [@expl:send_message ensures] [%#schat'9] chat_consistent_creusot result.f0)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let rec send_message_creusot [#"/home/erik/repos/valinoreth/valinoreth_proofs/src/creusot/generated/chat.rs" 62 0 65 45]
  (state: t_ChatState) (proof: t_Established_ChatConsistent) (return (x: tup2_ChatState_Established_ChatConsistent)) =
  {[@stop_split] [@expl:send_message_creusot requires] ([@stop_split] [@expl:send_message_creusot 'state' type invariant] [%#schat'0] inv_ChatState state)
  /\ ([@stop_split] [@expl:send_message_creusot 'proof' type invariant] [%#schat'1] inv_Established_ChatConsistent proof)
  /\ ([@stop_split] [@expl:send_message_creusot requires] [%#schat'2] chat_consistent_creusot state)}
  (! bb0
  [ bb0 = s0
    [ s0 = send_message [%#schat] {state} {proof}
        (fun (_x: tup2_ChatState_Established_ChatConsistent) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: tup2_ChatState_Established_ChatConsistent = Any.any_l ()
  | & state: t_ChatState = state
  | & proof: t_Established_ChatConsistent = proof ])
  [ return (result: tup2_ChatState_Established_ChatConsistent) ->
  {[@stop_split] [@expl:send_message_creusot ensures] ([@stop_split] [@expl:send_message_creusot result type invariant] [%#schat'3] inv_tup2_ChatState_Established_ChatConsistent result)
    /\ ([@stop_split] [@expl:send_message_creusot ensures] [%#schat'4] chat_consistent_creusot result.f0)}
    (! return {result}) ]
